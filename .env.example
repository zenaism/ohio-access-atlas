# Copy to .env (never committed) and fill in. Keys stay on this computer.

# Reddit (after Reddit approves access; app type "script" at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ohio-access-atlas research by u/<your reddit username>
# Random secret used to scramble Reddit usernames (already filled in .env)
ANON_SALT=

# Google Places API (New), restricted to Places API, with a budget alert
GOOGLE_MAPS_API_KEY=
# Browser key for live Google Places details; HTTP-referrer restriction required
GOOGLE_MAPS_BROWSER_API_KEY=

# Claude API key, for the assistant
ANTHROPIC_API_KEY=

# Yelp Places API (only if you decide to pay for it)
YELP_API_KEY=
